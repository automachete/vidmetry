{
  "name": "vidmetry",
  "private": true,
  "version": "0.4.8",
  "license": "MIT",
  "type": "module",
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=24.12.0 <25",
    "npm": ">=11.18.0 <12"
  },
  "scripts": {
    "setup:privacy": "pwsh -NoProfile -File scripts/setup-privacy-guard.ps1",
    "check:privacy": "pwsh -NoProfile -File scripts/privacy-guard.ps1 -Mode Repository",
    "test:privacy": "pwsh -NoProfile -File scripts/privacy-guard.ps1 -Mode SelfTest",
    "test:release-version": "pwsh -NoProfile -File scripts/test-release-version.ps1",
    "generate:contracts": "node scripts/generate-error-contract.mjs",
    "check:contracts": "node scripts/generate-error-contract.mjs --check",
    "check:licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"0BSD;Apache-2.0;BSD-2-Clause;BSD-3-Clause;CC0-1.0;ISC;MIT;Unicode-3.0;Unicode-DFS-2016;Zlib\"",
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.app.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:assets": "pwsh -NoProfile -File scripts/test-icon-assets.ps1",
    "test:shell": "pwsh -NoProfile -File scripts/test-shell-integration.ps1",
    "test:nsis": "pwsh -NoProfile -File scripts/test-nsis-package.ps1",
    "test:msix": "pwsh -NoProfile -File scripts/test-msix-package.ps1",
    "test:runtime": "pwsh -NoProfile -File scripts/test-runtime-contracts.ps1",
    "test:licenses": "pwsh -NoProfile -File scripts/test-license-compliance.ps1",
    "test:ui": "playwright test",
    "test:integration": "pwsh -NoProfile -File scripts/test-integration.ps1",
    "msix:build": "pwsh -NoProfile -File scripts/build-msix.ps1",
    "nsis:build": "pwsh -NoProfile -File scripts/build-nsis.ps1",
    "verify": "npm run test:privacy && npm run check:privacy && npm run test:release-version && npm run check:contracts && npm run check:licenses && npm run check && npm run test:assets && npm run test:shell && npm run test:runtime && npm run test:licenses && npm test && npm run build",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-store": "^2.4.4",
    "i18next": "^26.3.6",
    "svelte": "^5.56.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "5.0.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  }
}
